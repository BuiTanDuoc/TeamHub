{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=TeamHub;Trusted_Connection=true;TrustServerCertificate=True"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "TeamHub",
    "Audience": "TeamHub.Clients",
    "SigningKey": "1234567890asdfghjklzxcvbnmqwertyuiop1234567890",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "Google": {
      "ClientIds": [],
      "AutoCreateUsers": true,
      "AllowedDomains": []
    }
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false
    },
    "Lockout": {
      "AllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00"
    },
    "User": {
      "RequireUniqueEmail": true
    }
  },
  "Paging": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "Hangfire": {
    "Enabled": true
  },
  "Notifications": {
    "Cleanup": {
      "Cron": "0 20 * * *",
      "ReadRetentionDays": 30,
      "MaxRetentionDays": 180,
      "BatchSize": 1000
    }
  },
  "Bugs": {
    "Sla": {
      "Critical": 24,
      "Major": 72,
      "Minor": 168,
      "Trivial": 336
    }
  },
  "Push": {
    "Expo": {
      "Enabled": true,
      "Endpoint": "https://exp.host/--/api/v2/push/send",
      "TimeoutSeconds": 5
    }
  },
  "Kanban": {
    "MaxCardsPerColumn": 50
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Seed": {
    "Admin": {
      "Email": "",
      "Password": "",
      "FullName": "System Admin"
    }
  }
}
