# Để trống khi dev (dùng proxy của Vite). Production: URL gốc của API, vd https://api.teamhub.example.com
VITE_API_URL=
# Backend để Vite proxy tới khi dev
DEV_API_TARGET=https://localhost:31034
# Google OAuth Web Client ID (trùng một giá trị trong Auth:Google:ClientIds của backend). Để trống = ẩn nút Google
VITE_GOOGLE_CLIENT_ID=
